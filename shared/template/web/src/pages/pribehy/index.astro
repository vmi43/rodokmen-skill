---
import Base from '../../layouts/Base.astro';
import { docs, config, lineByK, href } from '../../lib/data.js';
import { Content, frontmatter } from '../../generated/pribeh.md';
const dalsi = config.dalsiPribehy ?? [];
const line = lineByK[config.pribeh?.rod ?? 8];
---
<Base title={frontmatter.title}>
  <p class="crumbs">{line && <><a href={href.line(line.slug)}>rod {line.name}</a> · </>}<a href="/zajimavosti/">další zajímavosti</a></p>
  <h1>{config.maHlavniPribeh ? frontmatter.title : (config.pribeh?.menu || 'Příběhy')}</h1>
  {config.maHlavniPribeh && frontmatter.lead && <p class="lead">{frontmatter.lead}</p>}
  {config.maHlavniPribeh && <div class="prose"><Content /></div>}

  {dalsi.length > 0 && (
    <>
      <h2>{config.maHlavniPribeh ? 'Další příběhy' : 'Příběhy'}</h2>
      <ul>
        {dalsi.map((p) => <li><a href={`/pribehy/${p.slug}/`}>{p.title}</a>{p.obdobi && <span class="muted"> ({p.obdobi})</span>}{p.lead && <> – {p.lead}</>}</li>)}
      </ul>
    </>
  )}

  <div class="next-step">
    <p><strong>Chcete víc?</strong> Další objevy z rodokmenu najdete v zajímavostech.</p>
    <a class="btn" href="/zajimavosti/">Zajímavosti z rodokmenu →</a>
  </div>

  {docs.length > 0 && (
    <>
      <h2>Rodinné dokumenty a fotografie</h2>
      <div class="docs">
        {docs.map((d) => (
          <figure><a href={`/img/${d.img}.jpg`} target="_blank" rel="noopener"><img src={`/img/${d.img}.jpg`} alt={d.caption} loading="lazy" /></a><figcaption>{d.caption}</figcaption></figure>
        ))}
      </div>
    </>
  )}
</Base>
