# Sestavení i běh na ověřených Red Hat UBI image, pevná verze, bez root (UID 1001), port 8080.
# Sestavení:  podman build -t rodokmen-web -f Containerfile .
# Spuštění:   podman run --rm -p 8080:8080 rodokmen-web
# Před sestavením musí existovat nginx.conf a data webu – vyrábí je `npm run data -- --nasazeni`.
FROM registry.access.redhat.com/ubi9/nodejs-24:1-1779693239 AS build
WORKDIR /opt/app-root/src
COPY --chown=1001:0 package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY --chown=1001:0 . .
RUN npm run build

FROM registry.access.redhat.com/ubi9/nginx-126:1-1777855212
COPY --chown=1001:0 nginx.conf /etc/nginx/nginx.conf
COPY --from=build --chown=1001:0 /opt/app-root/src/dist /opt/app-root/www
USER 1001
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
